{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimelie-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "services": [{ "binding": "API", "service": "mimelie-api" }],
  "routes": [{ "pattern": "painel-mimelie.vira.ia.br/*", "zone_name": "vira.ia.br" }]
}
