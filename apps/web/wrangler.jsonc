{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimelie-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_INTERNAL_URL": "https://mimelie-api.vira.ia.br",
    "NEXT_PUBLIC_SITE_URL": "https://mimelie.vira.ia.br",
    "NEXT_PUBLIC_ADMIN_URL": "https://mimelie-api.vira.ia.br"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mimelie-next-cache"
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "mimelie-api"
    }
  ],
  "routes": [
    {
      "pattern": "mimelie.vira.ia.br/*",
      "zone_name": "vira.ia.br"
    }
  ]
}
