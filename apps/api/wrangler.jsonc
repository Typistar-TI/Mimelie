{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimelie-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimelie-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mimelie-media" }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "mimelie-jobs" }]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "WEB_ORIGIN": "https://mimelie.com",
    "ADMIN_ORIGIN": "https://admin.mimelie.com",
    "API_PUBLIC_URL": "https://admin.mimelie.com",
    "PIX_KEY": "oi@mimelie.com.br",
    "PIX_MERCHANT_NAME": "MIMELIE",
    "PIX_MERCHANT_CITY": "SAO PAULO"
  }
}
