{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimelie",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimelie-db",
      "database_id": "17f108f5-394a-453a-9b3b-a636f4e6d63c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mimelie-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mimelie-next-cache"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "1c186fda0ac54e1daaf73b717d96f0bc"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "mimelie-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "mimelie-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "mimelie-jobs-dlq"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "WEB_ORIGIN": "https://mimelie.vira.ia.br",
    "ADMIN_ORIGIN": "https://painel-mimelie.vira.ia.br",
    "API_PUBLIC_URL": "https://api-mimelie.vira.ia.br",
    "PIX_KEY": "oi@mimelie.com.br",
    "PIX_MERCHANT_NAME": "MIMELIE",
    "PIX_MERCHANT_CITY": "SAO PAULO",
    "EMAIL_FROM": "oi@mimelie.com.br",
    "API_INTERNAL_URL": "https://api-mimelie.vira.ia.br"
  },
  "routes": [
    {
      "pattern": "mimelie.vira.ia.br/*",
      "zone_name": "vira.ia.br"
    },
    {
      "pattern": "api-mimelie.vira.ia.br/*",
      "zone_name": "vira.ia.br"
    },
    {
      "pattern": "painel-mimelie.vira.ia.br/*",
      "zone_name": "vira.ia.br"
    }
  ],
  "assets": {
    "directory": "../web/.open-next/assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/_next/image",
      "/v1/*",
      "/api/*",
      "/admin",
      "/admin/"
    ],
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
