{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimelie-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimelie-db",
      "database_id": "17f108f5-394a-453a-9b3b-a636f4e6d63c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mimelie-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "1c186fda0ac54e1daaf73b717d96f0bc"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "mimelie-jobs"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "WEB_ORIGIN": "https://mimelie.vira.ia.br",
    "ADMIN_ORIGIN": "https://painel-mimelie.vira.ia.br",
    "API_PUBLIC_URL": "https://api-mimelie.vira.ia.br",
    "PIX_KEY": "oi@mimelie.com.br",
    "PIX_MERCHANT_NAME": "MIMELIE",
    "PIX_MERCHANT_CITY": "SAO PAULO"
  },
  "routes": [
    {
      "pattern": "api-mimelie.vira.ia.br/*",
      "zone_name": "vira.ia.br"
    }
  ]
}
