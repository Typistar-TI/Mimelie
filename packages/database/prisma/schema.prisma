generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderChannel {
  SITE
  MERCADO_LIVRE
  SHOPEE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  INVOICED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum DiscountKind {
  PERCENT
  FIXED
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  kind        UserKind  @default(CUSTOMER)
  totpSecret  String?
  totpEnabled Boolean   @default(false)
  roles       UserRole[]
  sessions    Session[]
  magicLinks  MagicLink[]
  orders      Order[]
  consents    Consent[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model MagicLink {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([email, expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id       String           @id @default(cuid())
  resource String
  action   String
  scope    String           @default("all")
  roles    RolePermission[]
  @@unique([resource, action, scope])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Manufacturer {
  id              String    @id @default(cuid())
  legalName       String
  document        String?
  regulatoryOwner String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  name              String
  shortDescription  String
  description       Json
  status            ProductStatus @default(DRAFT)
  category          String
  regulatoryProcess String?
  manufacturerId    String?
  manufacturer      Manufacturer? @relation(fields: [manufacturerId], references: [id])
  variants          Variant[]
  images            ProductImage[]
  listings          ChannelListing[]
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([status, category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  alt       String
  position  Int     @default(0)
  @@index([productId, position])
}

model Variant {
  id          String                 @id @default(cuid())
  productId   String
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String                 @unique
  ean         String?                @unique
  name        String
  attributes  Json
  price       Int
  compareAt   Int?
  cost        Int?
  safetyStock Int                    @default(1)
  weightGrams Int
  widthCm     Int
  heightCm    Int
  lengthCm    Int
  active      Boolean                @default(true)
  batches     InventoryBatch[]
  reservations InventoryReservation[]
  orderItems  OrderItem[]
  channelVariants ChannelVariant[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model InventoryBatch {
  id           String   @id @default(cuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lot          String
  expiresAt    DateTime
  receivedAt   DateTime @default(now())
  quantity     Int
  available    Int
  regulatoryRef String?
  @@unique([variantId, lot])
  @@index([variantId, expiresAt])
}

model InventoryReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  @@index([variantId, status, expiresAt])
  @@index([orderId])
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique
  channel         OrderChannel @default(SITE)
  externalId      String?
  accessTokenHash String
  accessTokenCiphertext String
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  customerEmail   String
  customerName    String
  customerPhone   String?
  status          OrderStatus  @default(PENDING_PAYMENT)
  currency        String       @default("BRL")
  subtotal        Int
  discount        Int          @default(0)
  shipping        Int          @default(0)
  total           Int
  shippingAddress Json
  items           OrderItem[]
  payments        Payment[]
  shipment        Shipment?
  fiscalDocument  FiscalDocument?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([channel, externalId])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id])
  sku         String
  name        String
  quantity    Int
  unitPrice   Int
  total       Int
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  method         String?
  externalId     String?       @unique
  idempotencyKey String        @unique
  status         PaymentStatus @default(PENDING)
  amount         Int
  payload        Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  service     String
  quoteId     String?
  externalId  String?
  trackingCode String?
  labelUrl    String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FiscalDocument {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  accessKey String   @unique
  xmlKey    String?
  status    String
  issuedAt  DateTime
  createdAt DateTime @default(now())
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  kind        DiscountKind
  value       Int
  minimum     Int          @default(0)
  usageLimit  Int?
  usageCount  Int          @default(0)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean      @default(true)
}

model ContentPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  content     Json
  coverKey    String?
  status      PostStatus @default(DRAFT)
  seoTitle    String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ChannelListing {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel     OrderChannel
  externalId  String
  status      String
  variants    ChannelVariant[]
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([channel, externalId])
  @@unique([productId, channel])
}

model ChannelVariant {
  id          String         @id @default(cuid())
  listingId   String
  listing     ChannelListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  externalId  String
  lastStock   Int?
  lastPrice   Int?
  @@unique([listingId, variantId])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  externalId  String
  type        String
  status      WebhookStatus @default(RECEIVED)
  signatureOk Boolean
  payload     Json
  attempts    Int           @default(0)
  error       String?
  occurredAt  DateTime?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  @@unique([provider, externalId, type])
  @@index([status, createdAt])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  topic       String
  aggregateId String
  payload     Json
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([processedAt, availableAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  @@index([resource, resourceId, createdAt])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  type      String
  version   String
  granted   Boolean
  createdAt DateTime @default(now())
  @@index([userId, type])
}
